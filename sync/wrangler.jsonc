{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rally-sim-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "Account" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }],
  "vars": {
    // Kommaseparerade origins som får anropa API:t. Sätts när spelet har en adress.
    "ALLOWED_ORIGINS": "",
  },
  "observability": { "enabled": true },
}
