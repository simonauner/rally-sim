{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rally-sim-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "Account" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }],
  "vars": {
    // Comma-separated origins allowed to call the API (without path). The game is on GitHub Pages,
    // which redirects simonauner.github.io to the custom domain www.auner.se.
    "ALLOWED_ORIGINS": "https://www.auner.se,https://simonauner.github.io",
  },
  "observability": { "enabled": true },
}
