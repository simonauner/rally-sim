{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rally-sim-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "Account" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }],
  "vars": {
    // Kommaseparerade origins som får anropa API:t (utan sökväg). Spelet ligger på GitHub Pages,
    // som skickar vidare simonauner.github.io till den egna domänen www.auner.se.
    "ALLOWED_ORIGINS": "https://www.auner.se,https://simonauner.github.io",
  },
  "observability": { "enabled": true },
}
